node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Local development files
instance/
*.db
*.sqlite
*.sqlite3

# Environment files (secrets should be in Secret Manager)
.env
.env.local
.env.*.local

# Uploads folder (should be in Cloud Storage)
uploads/

# Documentation and helper files
*.md
!README.md

# Local credential files
*password*.txt
*secret*.txt
credentials.json

# Google Cloud SDK (if installed locally)
gcloud/
gcloud

# Windows special files
nul
NUL

