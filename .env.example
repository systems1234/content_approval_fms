# --- Flask ---
SECRET_KEY=change-me
FLASK_ENV=development

# --- BigQuery (the only datastore; nothing is kept anywhere else) ---
BIGQUERY_PROJECT=mis-gempundit
BIGQUERY_DATASET=Content_FMS
# Service-account JSON on one line. On Vercel, paste it as an env var.
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# --- Access ---
# Off: the app opens on the dashboard and you switch identity in the header.
# On: Google Workspace SSO gates everything (needs the two keys below).
REQUIRE_SIGNIN=0
DEFAULT_ACTOR_EMAIL=vivek@gempundit.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_WORKSPACE_DOMAIN=gempundit.com

# --- Stage 1 output ---
# Defaults to <project>.<dataset>.AI_Content_Queue with the column names in
# schema.sql, so these only need setting if the automation names things differently.
AI_SOURCE_TABLE=mis-gempundit.Content_FMS.AI_Content_Queue
AI_KEY_COLUMN=unique_key
AI_STATUS_COLUMN=status
# AI_COLUMN_MAP={"content_text":"ai_draft","content_url":"ai_draft_url"}

# --- Machine auth for /api/* ---
WORKFLOW_API_KEY=
