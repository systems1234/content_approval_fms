# --- Flask ---
SECRET_KEY=change-me
FLASK_ENV=development

# --- BigQuery ---
BIGQUERY_PROJECT=mis-gempundit
BIGQUERY_DATASET=Content_FMS
# Paste the whole service-account JSON on one line (Vercel env var)
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# --- Google Workspace SSO (required: this app has no password login) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_WORKSPACE_DOMAIN=gempundit.com

# --- AI draft source (fill in once the manager's table exists) ---
# Fully-qualified table the AI writes its finished drafts into.
AI_SOURCE_TABLE=mis-gempundit.Content_FMS.AI_Content
# Column in that table that uniquely identifies one piece of content.
AI_KEY_COLUMN=unique_key
# Map our workflow fields <- their column names. Unmapped columns are still
# captured verbatim and shown on the item page, so this can stay minimal.
AI_COLUMN_MAP={"category":"category","content_text":"content","content_url":"content_url","word_count":"word_count","search_keywords":"keywords","search_volume":"search_volume"}

# --- Machine-to-machine auth for /api/* ---
WORKFLOW_API_KEY=
